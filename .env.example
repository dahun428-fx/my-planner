# .env.example을 .env로 복사하고 값을 채웁니다. .env는 Git에 넣지 않습니다.
# BotFather에서 받은 봇 토큰
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-token
# 본인 텔레그램 숫자 ID (@userinfobot 등으로 확인)
OWNER_TELEGRAM_ID=123456789
# HTTP API 토큰 (43자 이상). `python -m my_planner gen-token`으로 만든다. 비우면 API를 열지 않는다
API_TOKEN=
# 아이폰 단축어의 몸 기록 토큰(43자 이상, API_TOKEN과 다른 값). gen-token으로 하나 더 만든다. POST /api/v1/body만 된다.
# 쓰지 않는 동안 비워 두면 시작할 때 body_token_missing 경고가 한 줄 남는데 정상이다. 단축어와 토큰은 공유하지 않는다(README "iPhone 단축어")
# 비우거나 짧거나 API_TOKEN과 같으면 그 경로만 열지 않는다(다른 경로는 그대로)
BODY_TOKEN=
# 공부 앱(AI 듀오링고)의 진도 토큰(43자 이상, API_TOKEN·BODY_TOKEN과 다른 값). gen-token으로 하나 더 만든다.
# GET·PUT /api/v1/study/progress만 된다. 비우면 그 경로만 열지 않는다(README "공부 앱 진도 맞추기", ADR 0024)
STUDY_TOKEN=
# 웹 푸시(운영 앱 알림). `python -m my_planner gen-vapid`가 출력한 두 줄을 붙여 넣고 VAPID_SUBJECT에 mailto: 주소를 적는다.
# 셋 중 하나라도 비면 푸시를 끄고(/push/*는 404) 회차는 텔레그램으로만 간다. 비밀키는 .env에만 둔다
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# 자동 복구(medic)가 GitHub 이슈·fetch에 쓰는 토큰. fine-grained PAT, 이 저장소만: Issues 읽기·쓰기, Contents 읽기, Actions 읽기, Commit statuses 읽기. 비우면 GitHub 호출이 인증 없이 나가 실패해서 하트비트·이슈·배포가 멈춘다
MEDIC_GITHUB_TOKEN=
