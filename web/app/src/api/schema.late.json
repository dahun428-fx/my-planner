              "enum": [
                "todo",
                "event",
                "memo",
                "today",
                "next",
                "mate_today",
                "mate_log",
                "mate_plan",
                "manager_full",
                "manager_week"
              ],
              "type": "string"
            },
            {
              "type": "null"
